---
// src/pages/index.astro
const title = "Taller de Tapicería para Interioristas y Proyectos Contract | Andalucía";
const description = "Taller de tapicería artesanal en Andalucía especializado en la ejecución de proyectos contract y residencial de alta gama para estudios de interiorismo y arquitectura.";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
	<link rel="stylesheet" href="/src/styles/global.css" />
    
    <!-- SEO Meta Tags Primarios B2B -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="taller de tapiceria para interioristas, tapiceria contract andalucia, ejecucion mobiliario a medida, tapiceria artesanal alta gama, tapiceria hoteles de lujo" />

    <!-- Fuentes elegantes de Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  </head>

  <body class="bg-zinc-950 text-zinc-300 font-sans antialiased selection:bg-amber-900 selection:text-amber-100 min-h-screen flex flex-col justify-between">
    
    <!-- Header / Navegación Elegante -->
    <header class="border-b border-zinc-900 bg-zinc-950/85 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 h-24 flex items-center justify-between">
        <a href="/" class="group">
          <span class="font-serif text-2xl tracking-widest uppercase text-zinc-100 group-hover:text-amber-500 transition-colors">
            Taller Artesanal
          </span>
          <span class="block text-[10px] tracking-[0.3em] uppercase text-zinc-500 font-sans">
            Andalucía · Ejecución Contract
          </span>
        </a>

        <nav class="hidden md:flex items-center space-x-10 text-xs uppercase tracking-widest font-medium text-zinc-400">
          <a href="#oficio" class="hover:text-amber-400 transition-colors">El Oficio</a>
          <a href="#capacidades" class="hover:text-amber-400 transition-colors">Capacidades</a>
          <a href="#proyectos" class="hover:text-amber-400 transition-colors">Proyectos</a>
          <a href="#contacto" class="hover:text-amber-400 transition-colors">Contacto Profesional</a>
        </nav>

        <a href="#contacto" class="inline-flex items-center justify-center px-5 py-2.5 text-xs uppercase tracking-widest font-medium border border-zinc-800 text-zinc-200 hover:border-amber-700/50 hover:bg-zinc-900 hover:text-amber-400 transition-all">
          Iniciar Proyecto
        </a>
      </div>
    </header>

    <main>
      <!-- Hero Section B2B -->
      <section class="relative py-28 md:py-36 border-b border-zinc-900 overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 relative z-10">
          <div class="max-w-3xl">
            <span class="inline-block text-amber-500 text-xs font-semibold uppercase tracking-[0.25em] mb-4">
              Socio Técnico de Tapicería en Andalucía
            </span>
            <h1 class="font-serif text-4xl md:text-6xl text-zinc-100 font-normal leading-tight mb-8">
              Ejecución de tapicería artesanal de alta gama para proyectos de interiorismo y contract.
            </h1>
            <p class="text-zinc-400 text-base md:text-lg leading-relaxed mb-10 font-light max-w-2xl">
              Materializamos el diseño de arquitectos y estudios de interiorismo con precisión constructiva, respetando los planos, plazos de entrega y especificaciones técnicas para hoteles boutique, villas singulares y residencias de lujo.
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="#contacto" class="px-8 py-4 bg-zinc-100 text-zinc-950 text-xs uppercase tracking-widest font-semibold hover:bg-amber-400 transition-colors text-center">
                Contactar con el Taller
              </a>
              <a href="#capacidades" class="px-8 py-4 border border-zinc-800 text-zinc-300 text-xs uppercase tracking-widest font-semibold hover:bg-zinc-900 transition-colors text-center">
                Capacidades Técnicas
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Propuesta de Valor / Posicionamiento No-Creativo -->
      <section id="oficio" class="py-24 border-b border-zinc-900 bg-zinc-950">
        <div class="max-w-7xl mx-auto px-6">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
            <div class="lg:col-span-4">
              <h2 class="font-serif text-3xl text-zinc-100 font-normal leading-snug">
                El rigor de la ejecución. Su visión, nuestra maestría artesanal.
              </h2>
            </div>
            <div class="lg:col-span-8 grid grid-cols-1 md:grid-cols-2 gap-10">
              <div>
                <h3 class="text-sm font-semibold uppercase tracking-wider text-amber-500 mb-3">
                  Sin conflicto creativo
                </h3>
                <p class="text-zinc-400 text-sm leading-relaxed">
                  No vendemos diseño propio ni competimos con el prescriptor. Nos centramos al 100% en ser el socio constructivo que convierte renders y planos de detalle en piezas reales sin desviaciones.
                </p>
              </div>

              <div>
                <h3 class="text-sm font-semibold uppercase tracking-wider text-amber-500 mb-3">
                  Solvencia en proyectos contract
                </h3>
                <p class="text-zinc-400 text-sm leading-relaxed">
                  Tratamiento de espumas ignífugas, tejidos de alto tránsito (Martindale elevado), estructuras reforzadas de madera noble y cumplimiento normativo para espacios públicos y hoteleros.
                </p>
              </div>

              <div>
                <h3 class="text-sm font-semibold uppercase tracking-wider text-amber-500 mb-3">
                  Oficio y tradición andaluza
                </h3>
                <p class="text-zinc-400 text-sm leading-relaxed">
                  Dominio del cinchado tradicional, cincha de yute, muelle helicoidal manual, capitoné técnico y patronaje de precisión en pieles y terciopelos de alto gramaje.
                </p>
              </div>

              <div>
                <h3 class="text-sm font-semibold uppercase tracking-wider text-amber-500 mb-3">
                  Seguimiento e informes técnicos
                </h3>
                <p class="text-zinc-400 text-sm leading-relaxed">
                  Documentación del proceso de fabricación para el estudio, muestras físicas de acabado y control de calidad previo al envío o montaje en obra.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Capacidades Técnicas / Tipologías de Mobiliario -->
      <section id="capacidades" class="py-24 border-b border-zinc-900 bg-zinc-900/30">
        <div class="max-w-7xl mx-auto px-6">
          <div class="mb-16">
            <span class="text-amber-500 text-xs font-semibold uppercase tracking-[0.25em] block mb-2">
              Especialidades del Taller
            </span>
            <h2 class="font-serif text-3xl md:text-4xl text-zinc-100">
              Especialización en mobiliario tapizado a medida
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="border border-zinc-800/80 p-8 bg-zinc-950/60">
              <span class="text-zinc-600 font-serif text-2xl mb-4 block">01</span>
              <h3 class="font-serif text-xl text-zinc-100 mb-3">Paneles y Cabeceros de Gran Formato</h3>
              <p class="text-zinc-400 text-sm leading-relaxed mb-4">
                Instalaciones verticales para dormitorios principales y suites de hotel. Integración de pasacables, mecanismos y acústica.
              </p>
              <span class="text-[11px] uppercase tracking-widest text-amber-500 font-medium">Contrato & Residencial</span>
            </div>

            <div class="border border-zinc-800/80 p-8 bg-zinc-950/60">
              <span class="text-zinc-600 font-serif text-2xl mb-4 block">02</span>
              <h3 class="font-serif text-xl text-zinc-100 mb-3">Asientos Contract y Bancadas a Medida</h3>
              <p class="text-zinc-400 text-sm leading-relaxed mb-4">
                Sillería, sofás modulares y bancadas a medida para restaurantes, zonas nobles de hoteles y lobbies con alto desgaste.
              </p>
              <span class="text-[11px] uppercase tracking-widest text-amber-500 font-medium">Uso Intensivo</span>
            </div>

            <div class="border border-zinc-800/80 p-8 bg-zinc-950/60">
              <span class="text-zinc-600 font-serif text-2xl mb-4 block">03</span>
              <h3 class="font-serif text-xl text-zinc-100 mb-3">Piezas Singulares y Restauración de Autor</h3>
              <p class="text-zinc-400 text-sm leading-relaxed mb-4">
                Tapizado de prototipos, piezas icónicas de diseño contemporáneo o clásico con acabados en piel noble y costuras vistas.
              </p>
              <span class="text-[11px] uppercase tracking-widest text-amber-500 font-medium">Bespoke / Artesanal</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Proyectos / Casos de Estudio -->
      <section id="proyectos" class="py-24 border-b border-zinc-900">
        <div class="max-w-7xl mx-auto px-6">
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-4">
            <div>
              <span class="text-amber-500 text-xs font-semibold uppercase tracking-[0.25em] block mb-2">
                Casos de Ejecución
              </span>
              <h2 class="font-serif text-3xl md:text-4xl text-zinc-100">
                Colaboraciones con Estudios de Interiorismo
              </h2>
            </div>
            <p class="text-zinc-500 text-xs uppercase tracking-widest">
              Garantía de confidencialidad en proyectos de autor
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            <div class="border border-zinc-900 bg-zinc-950 p-6">
              <div class="aspect-[16/9] bg-zinc-900 mb-6 flex items-center justify-center text-zinc-700 text-sm font-mono">
                [ Fotografía de proyecto ]
              </div>
              <span class="text-amber-500 text-[11px] uppercase tracking-widest font-semibold block mb-1">
                Hotel Boutique · Sevilla
              </span>
              <h3 class="font-serif text-2xl text-zinc-100 mb-2">
                Ejecución de bancadas y suites principales
              </h3>
              <p class="text-zinc-400 text-sm leading-relaxed">
                Fabricación de 14 cabeceros tapizados en terciopelo ignífugo y bancadas para la zona de restauración según planos del estudio prescriptor.
              </p>
            </div>

            <div class="border border-zinc-900 bg-zinc-950 p-6">
              <div class="aspect-[16/9] bg-zinc-900 mb-6 flex items-center justify-center text-zinc-700 text-sm font-mono">
                [ Fotografía de proyecto ]
              </div>
              <span class="text-amber-500 text-[11px] uppercase tracking-widest font-semibold block mb-1">
                Villa Privada · Marbella
              </span>
              <h3 class="font-serif text-2xl text-zinc-100 mb-2">
                Mobiliario bespoke y paneles acústicos
              </h3>
              <p class="text-zinc-400 text-sm leading-relaxed">
                Desarrollo e instalación de sofá modular de 6 metros en piel natural tratada y revestimiento textil modular para zona de cine.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Sección de Contacto Profesional -->
      <section id="contacto" class="py-24 bg-zinc-950">
        <div class="max-w-7xl mx-auto px-6">
          <div class="max-w-2xl mx-auto text-center mb-16">
            <span class="text-amber-500 text-xs font-semibold uppercase tracking-[0.25em] block mb-2">
              Atención Exclusiva a Profesionales
            </span>
            <h2 class="font-serif text-3xl md:text-5xl text-zinc-100 mb-6">
              Inicie la ejecución de su proyecto
            </h2>
            <p class="text-zinc-400 text-sm md:text-base leading-relaxed">
              Analizamos sus planos, memoria de calidades y mediciones para ofrecer una propuesta técnica ajustada a sus necesidades.
            </p>
          </div>

          <div class="max-w-xl mx-auto border border-zinc-900 bg-zinc-900/40 p-8 md:p-10">
            <form class="space-y-6">
              <div>
                <label class="block text-xs uppercase tracking-widest text-zinc-400 mb-2">Nombre o Estudio de Interiorismo</label>
                <input type="text" class="w-full bg-zinc-950 border border-zinc-800 px-4 py-3 text-sm text-zinc-100 focus:outline-none focus:border-amber-600 transition-colors" placeholder="Ej. Estudio María Santos" />
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block text-xs uppercase tracking-widest text-zinc-400 mb-2">Correo Electrónico</label>
                  <input type="email" class="w-full bg-zinc-950 border border-zinc-800 px-4 py-3 text-sm text-zinc-100 focus:outline-none focus:border-amber-600 transition-colors" placeholder="contacto@estudio.com" />
                </div>
                <div>
                  <label class="block text-xs uppercase tracking-widest text-zinc-400 mb-2">Teléfono</label>
                  <input type="tel" class="w-full bg-zinc-950 border border-zinc-800 px-4 py-3 text-sm text-zinc-100 focus:outline-none focus:border-amber-600 transition-colors" placeholder="+34 600 000 000" />
                </div>
              </div>

              <div>
                <label class="block text-xs uppercase tracking-widest text-zinc-400 mb-2">Detalles del Proyecto / Tipo de Colaboración</label>
                <textarea rows="4" class="w-full bg-zinc-950 border border-zinc-800 px-4 py-3 text-sm text-zinc-100 focus:outline-none focus:border-amber-600 transition-colors" placeholder="Describa el tipo de pieza, escala del proyecto o adjunte especificaciones..."></textarea>
              </div>

              <button type="submit" class="w-full py-4 bg-zinc-100 text-zinc-950 font-semibold text-xs uppercase tracking-widest hover:bg-amber-400 transition-colors">
                Enviar Solicitud Técnica
              </button>
            </form>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer Sobrio -->
    <footer class="border-t border-zinc-900 bg-zinc-950 py-12">
      <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6 text-xs text-zinc-500">
        <div>
          <span class="font-serif text-sm text-zinc-300">Taller de Tapicería Artesanal</span> — Andalucía, España.
        </div>
        <div>
          &copy; {new Date().getFullYear()} Todos los derechos reservados. Ejecución exclusiva para profesionales.
        </div>
      </div>
    </footer>

  </body>
</html>