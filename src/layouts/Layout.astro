---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  keywords?: string;
}

const { 
  title, 
  description, 
  keywords = "atelier tapiceria, taller de tapiceria para interioristas, proveedor de tapiceria contract, ejecucion de mobiliario a medida, tapiceria artesanal andalucia" 
} = Astro.props;
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />

    <!-- Fuentes editoriales y técnicas -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>

  <body class="bg-[#FAF9F6] text-stone-800 font-sans antialiased selection:bg-amber-800 selection:text-white min-h-screen flex flex-col justify-between">
    
    <!-- Navegación Minimalista -->
    <header class="border-b border-stone-200/80 bg-[#FAF9F6]/90 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 lg:px-12 h-24 flex items-center justify-between">
        <a href="/" class="group flex flex-col">
          <span class="font-serif text-2xl tracking-[0.2em] uppercase text-stone-900 group-hover:text-amber-800 transition-colors">
            Atelier Tapicería
          </span>
          <span class="text-[9px] tracking-[0.35em] uppercase text-stone-500 mt-0.5">
            Andalucía · Ejecución Contract
          </span>
        </a>

        <nav class="hidden md:flex items-center space-x-10 text-[11px] uppercase tracking-[0.2em] font-medium text-stone-600">
          <a href="/#oficio" class="hover:text-stone-950 transition-colors">El Oficio</a>
          <a href="/#capacidades" class="hover:text-stone-950 transition-colors">Capacidades</a>
          <a href="/#especificaciones" class="hover:text-stone-950 transition-colors">Especificaciones</a>
          <a href="/#proyectos" class="hover:text-stone-950 transition-colors">Proyectos</a>
        </nav>

        <div class="flex items-center">
          <a href="/#contacto" class="px-6 py-3 text-[11px] uppercase tracking-[0.2em] font-medium border border-stone-300 text-stone-900 hover:border-stone-900 hover:bg-stone-900 hover:text-[#FAF9F6] transition-all">
            Colaborar
          </a>
        </div>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer Arquitectónico -->
    <footer class="border-t border-stone-200 bg-[#F4F2EC] py-16">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 pb-12 border-b border-stone-200 text-xs text-stone-600">
          <div>
            <span class="font-serif text-lg tracking-widest uppercase text-stone-900 block mb-3">
              Atelier Tapicería
            </span>
            <p class="leading-relaxed max-w-xs font-light">
              Taller de ejecución artesanal en Andalucía para estudios de interiorismo, arquitectura y proyectos contract de alta gama.
            </p>
          </div>
          <div>
            <span class="text-[10px] uppercase tracking-[0.25em] text-stone-900 font-semibold block mb-3">
              Especialidades B2B
            </span>
            <ul class="space-y-2 font-light">
              <li>Ejecución de mobiliario a medida</li>
              <li>Proveedor de tapicería contract</li>
              <li>Panelados acústicos y cabeceros</li>
            </ul>
          </div>
          <div>
            <span class="text-[10px] uppercase tracking-[0.25em] text-stone-900 font-semibold block mb-3">
              Taller & Oficina Técnica
            </span>
            <p class="font-light leading-relaxed">
              Andalucía, España<br />
              Atención exclusiva bajo cita previa y envío de planos.
            </p>
          </div>
        </div>
        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-stone-500 tracking-wider">
          <span>&copy; {new Date().getFullYear()} Atelier Tapicería. Todos los derechos reservados.</span>
          <span>Confidencialidad garantizada para estudios prescriptores.</span>
        </div>
      </div>
    </footer>

    <!-- Script global de animación de líneas por Scroll -->
    <script>
      const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.1
      };

      const lineObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
          } else {
            entry.target.classList.remove('is-visible');
          }
        });
      }, observerOptions);

      document.querySelectorAll('.reveal-line-left, .reveal-line-right').forEach(line => {
        lineObserver.observe(line);
      });
    </script>

    <!-- Botón Back to Top Minimalista -->
    <button 
      id="back-to-top" 
      aria-label="Volver arriba"
      class="fixed bottom-8 right-8 z-40 opacity-0 translate-y-4 pointer-events-none transition-all duration-500 w-12 h-12 bg-[#FAF9F6]/90 backdrop-blur-md border border-stone-200 text-stone-600 hover:text-stone-900 hover:border-stone-900 flex items-center justify-center text-2xl shadow-sm cursor-pointer"
    >
      <span>↑</span>
    </button>

    <script>
      // Control de aparición del botón Back to Top según el scroll
      const backToTopBtn = document.getElementById('back-to-top');

      window.addEventListener('scroll', () => {
        if (window.scrollY > 500) {
          backToTopBtn?.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
          backToTopBtn?.classList.add('opacity-100', 'translate-y-0');
        } else {
          backToTopBtn?.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
          backToTopBtn?.classList.remove('opacity-100', 'translate-y-0');
        }
      });

      backToTopBtn?.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });
    </script>

  </body>
</html>